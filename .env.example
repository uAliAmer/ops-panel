# Deployment config for the ops panel. Copy to .env and edit.
# Every value is optional — $lib/config.ts falls back to placeholder hosts, so
# the app builds and runs without any of them (see the demo flag at the bottom).

# Customer-facing tracking site. Operators share these links with customers.
VITE_PUBLIC_ORDER_ORIGIN=https://orders.example.com

# The panel's own canonical origin, used when one operator shares an order with
# another. Must be the domain where the app owns the root path.
VITE_OPS_APP_BASE=https://ops.example.com

# SSO portal that owns the operator directory. The panel bounces here when it
# has no session and comes back via /sso-callback.
VITE_PORTAL_URL=https://portal.example.com/login

# CDN serving product images by filename.
VITE_IMAGE_CDN=https://cdn.example.com

# The hostname this panel considers its own (bare host, no scheme). Only used to
# tell operators still on an old address that the app has moved. Leave unset if
# yours never moved.
VITE_CANONICAL_HOST=

# Demo mode: run with no backend at all. Every API call is answered from the
# in-memory fixtures in src/lib/demo, and the socket never dials out.
# `npm run demo` turns this on via .env.demo; on any deploy, appending ?demo=1
# to the URL does the same for that browser session.
VITE_DEMO=0
